[Unit]
Description=Codex Flight Service API
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=codex-flight
Group=codex-flight
WorkingDirectory=@APP_DIR@
EnvironmentFile=/etc/codex-flight-service/api.env
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--max-old-space-size=96
Environment=DATA_DIR=/var/lib/codex-flight-service/data
Environment=HOME=/var/lib/codex-flight-service
Environment=PATH=@NODE_DIR@:/usr/local/bin:/usr/bin:/bin
Environment=SERVICE_API_KEYS_FILE=%d/service-api-keys.json
LoadCredential=service-api-keys.json:/etc/codex-flight-service/service-api-keys.json
ExecStart=@NODE_BIN@ dist/src/main.js
Restart=on-failure
RestartSec=10
KillMode=mixed
TimeoutStopSec=15
StateDirectory=codex-flight-service
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
TasksMax=256
MemoryAccounting=true
MemoryMax=192M

[Install]
WantedBy=multi-user.target
