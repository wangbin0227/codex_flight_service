# Replace this domain; install Caddy separately or use an existing HTTPS reverse proxy.
flight.your-domain.com {
    encode zstd gzip
    request_body {
        max_size 20KB
    }
    reverse_proxy 127.0.0.1:8080
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        -Server
    }
}
