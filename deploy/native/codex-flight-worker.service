[Unit]
Description=Codex Flight Service Worker
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=codex-flight
Group=codex-flight
WorkingDirectory=@APP_DIR@
EnvironmentFile=/etc/codex-flight-service/worker.env
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--max-old-space-size=128
Environment=DATA_DIR=/var/lib/codex-flight-service/data
Environment=HOME=/var/lib/codex-flight-service
Environment=PATH=@NODE_DIR@:/usr/local/bin:/usr/bin:/bin
Environment=CODEX_BIN=@APP_DIR@/node_modules/.bin/codex
Environment=PLAYWRIGHT_BROWSERS_PATH=@APP_DIR@/browsers
Environment=CODEX_API_KEY_FILE=%d/model-api-key.txt
LoadCredential=model-api-key.txt:/etc/codex-flight-service/model-api-key.txt
ExecStart=@NODE_BIN@ dist/src/worker-main.js
Restart=on-failure
RestartSec=10
KillMode=mixed
TimeoutStopSec=15
StateDirectory=codex-flight-service
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
TasksMax=512
MemoryAccounting=true
MemoryHigh=512M
MemoryMax=768M
MemorySwapMax=1G
OOMPolicy=stop

[Install]
WantedBy=multi-user.target
