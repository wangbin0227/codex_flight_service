# Docker Compose reads these settings; real secrets go in ./secrets/ (never commit them).
SERVICE_DOMAIN=flight.example.com
CODEX_MODEL=gpt-6-sol
CODEX_REASONING_EFFORT=high
# Empty means the default OpenAI provider; a compatible provider must support Codex Responses/tool calls.
CODEX_BASE_URL=
WORKER_CONCURRENCY=2
JOB_TIMEOUT_SECONDS=600
MCP_STARTUP_TIMEOUT_SECONDS=60
MCP_TOOL_TIMEOUT_SECONDS=90
BROWSER_LAUNCH_TIMEOUT_SECONDS=45
BROWSER_NAVIGATION_TIMEOUT_SECONDS=45
BROWSER_WAIT_TIMEOUT_SECONDS=30
BROWSER_SNAPSHOT_TIMEOUT_SECONDS=20
BROWSER_PROXY_IDLE_TIMEOUT_SECONDS=60
MAX_ATTEMPTS=2
MAX_QUEUED=1000
MAX_OWNER_QUEUED=200
REQUESTS_PER_MINUTE=120
# Browser navigation and resources use public HTTPS; no domain lists are needed.
# Native development only (not needed for Compose):
# SERVICE_API_KEYS_FILE=./secrets/service-api-keys.json
# CODEX_API_KEY_FILE=./secrets/model-api-key.txt
# DATA_DIR=./runtime
# CODEX_BIN=./node_modules/.bin/codex
# HOST=127.0.0.1
# PORT=8080
