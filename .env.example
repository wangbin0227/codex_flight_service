# Docker Compose reads these settings; real secrets go in ./secrets/ (never commit them).
SERVICE_DOMAIN=flight.example.com
CODEX_MODEL=gpt-6-astra
# Empty means the default OpenAI provider; a compatible provider must support Codex Responses/tool calls.
CODEX_BASE_URL=
WORKER_CONCURRENCY=2
JOB_TIMEOUT_SECONDS=360
MAX_ATTEMPTS=2
MAX_QUEUED=1000
MAX_OWNER_QUEUED=200
REQUESTS_PER_MINUTE=120
# Optional CAPTCHA iframe/asset domains only; not allowed as top-level navigation destinations.
# Add the exact provider domains used by your airlines; see docs/captcha.md.
BROWSER_RESOURCE_HOSTS=
# Native development only (not needed for Compose):
# SERVICE_API_KEYS_FILE=./secrets/service-api-keys.json
# CODEX_API_KEY_FILE=./secrets/model-api-key.txt
# DATA_DIR=./runtime
# CODEX_BIN=./node_modules/.bin/codex
# HOST=127.0.0.1
# PORT=8080
